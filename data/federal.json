{
  "measures": [
    {
      "id": "unified",
      "title": "Единое пособие",
      "level": "federal",
      "status": "active",
      "legal_basis": [
        {
          "title": "Постановление Правительства РФ от 16.12.2022 № 2330",
          "role": "Правила назначения и выплаты единого пособия"
        },
        {
          "title": "Официальные разъяснения СФР на 2026 год",
          "role": "Актуальные условия применения"
        }
      ],
      "source_id": "sfr",
      "verified": "2026-09-29",
      "review_status": "verified",
      "jurisdiction": "RU",
      "effective_from": "2023-01-01",
      "effective_to": null,
      "eligibility": {
        "pregnancy_or_child_under_17": true,
        "needs_income_test": true,
        "needs_property_test": true,
        "needs_employment_rule_check": true,
        "income_limit_text": "Среднедушевой доход семьи — не выше 1 прожиточного минимума на душу населения в регионе.",
        "employment_rule_text": "Для трудоспособных членов семьи действует минимальный доход за расчётный период (правило 8 МРОТ) либо должна быть объективная причина отсутствия/недостатка дохода.",
        "property_rule_text": "Имущество семьи должно укладываться в установленные ограничения."
      },
      "notes": "Карточка должна отображаться как мера для проверки, а не как подтверждение права.",
      "rules": [
        {
          "id": "age",
          "effective_from": "2023-01-01",
          "value": "ребёнок младше 17 лет либо беременность при постановке на учёт до 12 недель"
        },
        {
          "id": "income_floor",
          "effective_from": "2026-01-01",
          "value": "минимальный доход трудоспособного члена семьи 8 МРОТ за расчётный период, если нет объективной причины"
        },
        {
          "id": "alimony_imputation",
          "effective_from": "2026-03-01",
          "value": "для предусмотренных правилами случаев алименты рассчитываются с использованием среднемесячной номинальной зарплаты по региону"
        },
        {
          "id": "care_zero_income",
          "effective_from": "2026-07-21",
          "value": "уход за нетрудоспособным учитывается как объективная причина при соблюдении обновлённых требований к родству"
        }
      ],
      "official_urls": [
        "https://sfr.gov.ru/grazhdanam/semyam_s_detmi/edinoe_posobie/",
        "https://sfr.gov.ru/files/id/press_center/pr/liflet/2026/4_Edinoe_posobie_na_detey_2026.pdf",
        "https://sfr.gov.ru/files/id/press_center/pr/liflet/2026/12_Otsenka_nujdaemosti_pri_naznachenii_edinogo_posobiya_2026.pdf"
      ],
      "amount": {
        "type": "variants",
        "variants": [
          {
            "label": "Базовый размер",
            "amount": "50% регионального прожиточного минимума для соответствующей категории"
          },
          {
            "label": "Повышенный размер",
            "amount": "75% регионального прожиточного минимума, если после 50% среднедушевой доход остаётся ниже ПМ"
          },
          {
            "label": "Максимальный размер",
            "amount": "100% регионального прожиточного минимума, если после 75% среднедушевой доход остаётся ниже ПМ"
          }
        ],
        "note": "Для ребёнка используется ПМ на ребёнка; для беременной женщины — ПМ трудоспособного населения."
      },
      "frequency": "monthly",
      "application": "Заявление: Госуслуги, клиентская служба СФР или МФЦ (в предусмотренных случаях)."
    },
